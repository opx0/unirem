DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Login throttling uses REMOTE_ADDR, not forwarded headers. Clients behind the
# same proxy share an IP budget unless trusted infrastructure supplies their IP.
# Restrict admin access at the reverse proxy as an additional safeguard.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=campus_radar
POSTGRES_USER=campus_radar
POSTGRES_PASSWORD=local-only-change-me
INTAKE_OCR_ENABLED=0
INTAKE_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
